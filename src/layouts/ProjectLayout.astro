---
import type { Project } from '../utils/projects';
import BaseLayout from './BaseLayout.astro';
import ProjectHeader from '../components/ProjectHeader.astro';
import ProjectSection from '../components/ProjectSection.astro';
import ProjectMedia from '../components/ProjectMedia.astro';
import ProjectNavigation from '../components/ProjectNavigation.astro';
import ProjectSubnav from '../components/ProjectSubnav.astro';
import CaseStudyIndex from '../components/CaseStudyIndex.astro';

interface Props {
  project: Project;
  previous?: Project;
  next?: Project;
}

const { project, previous, next } = Astro.props;
const chapterId = (title: string, index: number) =>
  `chapter-${index + 1}-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`;
const chapters = project.data.sections.map((section, index) => ({ id: chapterId(section.title, index), title: section.title }));
---

<BaseLayout title={project.data.title} description={project.data.description}>
  <article class="project-page">
    <ProjectSubnav currentProject={project} />
    <ProjectHeader project={project} />
    <div class="project-hero shell">
      <ProjectMedia media={project.data.heroMedia} ratio="wide" index={`P.${project.data.order.toString().padStart(2, '0')}`} />
    </div>
    <CaseStudyIndex chapters={chapters} />
    <div class="project-sections shell">
      {project.data.sections.map((section, index) => (
        <ProjectSection number={index + 1} id={chapters[index].id} {...section} />
      ))}
    </div>
    {project.data.repository && (
      <section class="repository-block shell" aria-labelledby="repository-title">
        <div>
          <p class="mono-label">Source code</p>
          <h2 id="repository-title">Repository</h2>
        </div>
        <a class="button-link" href={project.data.repository}>View repository ↗</a>
      </section>
    )}
    <ProjectNavigation previous={previous} next={next} />
  </article>
</BaseLayout>
