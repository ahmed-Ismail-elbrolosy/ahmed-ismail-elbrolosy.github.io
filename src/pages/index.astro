---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import { getArchiveProjects, getDedicatedProjects } from '../utils/projects';
import { education, experiences, personal, skills } from '../data/career';
import { assetPath } from '../utils/paths';

const projects = await getDedicatedProjects();
const archiveProjects = await getArchiveProjects();
---

<BaseLayout title="Home" description="Ahmed Elbrolosy is a systems engineer and product designer working across mechanical design, embedded systems, robotics, and intelligent autonomy.">
  <section id="home" class="hero shell scroll-section" aria-labelledby="hero-title">
    <div class="hero-code" aria-hidden="true">AE / 00</div>
    <div class="hero-main">
      <p class="hero-kicker">Ahmed Elbrolosy</p>
      <h1 id="hero-title">Systems Engineer <span>/</span> Product Designer</h1>
    </div>
    <div class="hero-statement">
      <p>I turn CAD, embedded hardware, control theory, SLAM, and computer vision into working physical products.</p>
      <a class="text-link" href="#projects">Selected work <span aria-hidden="true">↓</span></a>
    </div>
    <div class="hero-status">
      <span>Alexandria, Egypt</span>
      <span>Graduating May 2027</span>
      <span>Portfolio v0.1</span>
    </div>
  </section>

  <section id="projects" class="work-section shell scroll-section" aria-labelledby="selected-work-title">
    <header class="section-intro">
      <p class="section-code">INDEX / 01—07</p>
      <h2 id="selected-work-title">Selected Work</h2>
      <p>Robotics systems, control research, and engineering projects. Documentation is being expanded as evidence becomes available.</p>
    </header>
    <div class="featured-work">
      {projects.filter((project) => project.data.featured).map((project) => <ProjectPreview project={project} featured />)}
    </div>
    <div class="project-grid">
      {projects.filter((project) => !project.data.featured).map((project) => <ProjectPreview project={project} />)}
    </div>
  </section>

  <section class="archive-section shell" aria-labelledby="archive-title">
    <header class="section-intro compact">
      <p class="section-code">ARCHIVE / A—F</p>
      <h2 id="archive-title">Additional Work</h2>
      <p>Secondary project records from current source notes. Dedicated case studies may be added later.</p>
    </header>
    <div class="archive-list">
      {archiveProjects.map((project, index) => (
        <article class="archive-entry">
          <span class="archive-index">{String.fromCharCode(65 + index)}</span>
          <div>
            <p class="mono-label">{project.data.category}</p>
            <h3>{project.data.title}</h3>
            <p>{project.data.description}</p>
          </div>
          <p class="archive-tags">{project.data.stack.join(' · ')}</p>
          <div class="archive-meta">
            <span>{project.data.date}</span>
            <span>{project.data.status}</span>
            {project.data.image ? (
              <img class="archive-image" src={assetPath(project.data.image)} alt={project.data.imageAlt ?? project.data.title} width="400" height="240" loading="lazy" />
            ) : (
              <div class="archive-placeholder">
                <MediaPlaceholder label="PROJECT IMAGE PENDING" ratio="standard" index={String.fromCharCode(65 + index)} />
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="experience" class="about-section shell scroll-section" aria-labelledby="experience-title">
    <header class="about-section-heading">
      <span>02 /</span>
      <h2 id="experience-title">Experience</h2>
    </header>
    <div class="experience-list compact-experience-list">
      {experiences.map((experience, index) => (
        <article class:list={['experience-entry', 'compact', { pending: experience.pending }]}>
          <div class="experience-number">{(index + 1).toString().padStart(2, '0')}</div>
          <div class="experience-main">
            <p class="mono-label">{experience.type}{experience.location ? ` / ${experience.location}` : ''}</p>
            <h3>{experience.org}</h3>
            <p class="experience-role">{experience.role}</p>
            {experience.pending ? (
              <p class="pending-note">Entry reserved. Role, dates, responsibilities, and technologies will be added later.</p>
            ) : (
              <ul>
                {experience.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            )}
          </div>
          <div class="experience-aside">
            <p>{experience.period}</p>
            {experience.tags.length > 0 && <p>{experience.tags.join(' · ')}</p>}
            {experience.logo && (
              <div class="experience-logo">
                <img src={assetPath(experience.logo)} alt={experience.logoAlt ?? `${experience.org} logo`} width="400" height="160" loading="lazy" />
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="education" class="about-section shell scroll-section" aria-labelledby="education-title">
    <header class="about-section-heading">
      <span>03 /</span>
      <h2 id="education-title">Education</h2>
    </header>
    <article class="education-entry">
      <div>
        <p class="mono-label">{education.period}</p>
        <h3>{education.institution}</h3>
        <p>{education.degree}</p>
      </div>
      <dl>
        <div><dt>Location</dt><dd>{education.location}</dd></div>
        <div><dt>Standing</dt><dd>{education.year} · Expected {education.expectedGraduation}</dd></div>
        <div><dt>GPA</dt><dd>{education.gpa}</dd></div>
      </dl>
    </article>
  </section>

  <section id="skills" class="about-section shell scroll-section" aria-labelledby="skills-title">
    <header class="about-section-heading">
      <span>04 /</span>
      <h2 id="skills-title">Skills</h2>
    </header>
    <div class="skills-grid">
      {Object.entries(skills).map(([group, entries], index) => (
        <article class="skill-group">
          <p class="skill-group-index">{String(index + 1).padStart(2, '0')}</p>
          <h3>{group}</h3>
          <div class="skill-group-content">
            {entries.tools.length > 0 && (
              <div class="skill-tool-grid">
                {entries.tools.map((tool) => (
                  <div class="skill-tool-card">
                    <span class="skill-tool-icon" aria-hidden="true">{tool.icon}</span>
                    <strong>{tool.name}</strong>
                    <span>{tool.description}</span>
                  </div>
                ))}
              </div>
            )}
            {entries.tags.length > 0 && <div class="skill-tags">{entries.tags.map((tag) => <span>{tag}</span>)}</div>}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="contact" class="about-section shell scroll-section contact-section" aria-labelledby="contact-title">
    <header class="about-header home-about-header">
      <p class="section-code">05 / CONTACT</p>
      <h2 id="contact-title">Systems engineer and product designer for physical products with research depth.</h2>
      <p class="about-lead">I am {personal.name}, a mechatronics engineering student working across mechanical design, CAD, embedded electronics, control, SLAM, and computer vision. I build complete systems while keeping the technical depth needed for robotics research.</p>
    </header>
    <div class="resume-download">
      <div>
        <p class="mono-label">Resume</p>
        <p>Current engineering resume in PDF format.</p>
      </div>
      <a class="button-link" href={assetPath('/resume.pdf')} download>Download Resume ↓</a>
    </div>
    <section class="profile-grid" aria-label="Contact details">
      <div>
        <p class="mono-label">Base</p>
        <p>{personal.location}</p>
      </div>
      <div>
        <p class="mono-label">Contact</p>
        <a href={`mailto:${personal.email}`}>{personal.email}</a>
        <a href={`tel:${personal.phone.replaceAll(' ', '')}`}>{personal.phone}</a>
      </div>
      <div>
        <p class="mono-label">Profiles</p>
        <a class="social-link" href={personal.github}>
          <svg class="social-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.49c-2.23.49-2.7-.95-2.7-.95-.36-.93-.89-1.18-.89-1.18-.73-.5.06-.49.06-.49.81.06 1.23.83 1.23.83.72 1.23 1.88.87 2.34.67.07-.52.28-.87.51-1.07-1.78-.2-3.65-.89-3.65-3.96 0-.88.31-1.59.83-2.15-.08-.2-.36-1.02.08-2.12 0 0 .68-.22 2.2.82A7.67 7.67 0 0 1 8 4.8c.68 0 1.36.09 2 .27 1.52-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.52.56.83 1.27.83 2.15 0 3.08-1.88 3.76-3.66 3.96.29.25.54.73.54 1.47v2.18c0 .21.14.46.55.38A8 8 0 0 0 8 0Z" /></svg>
          GitHub ↗
        </a>
        <a class="social-link" href={personal.linkedin}>
          <svg class="social-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M0 1.15C0 .51.53 0 1.18 0h13.64C15.47 0 16 .51 16 1.15v13.7c0 .64-.53 1.15-1.18 1.15H1.18C.53 16 0 15.49 0 14.85V1.15ZM4.75 13.39V6.17H2.35v7.22h2.4ZM3.55 5.18c.84 0 1.52-.68 1.52-1.52a1.52 1.52 0 1 0-3.04 0c0 .84.68 1.52 1.52 1.52ZM13.65 13.39V9.44c0-2.12-.45-3.75-2.93-3.75-1.19 0-1.99.65-2.32 1.27h-.03V6.17H6.08v7.22h2.39V9.82c0-.94.18-1.85 1.35-1.85 1.15 0 1.17 1.08 1.17 1.91v3.51h2.66Z" /></svg>
          LinkedIn ↗
        </a>
      </div>
    </section>
  </section>
</BaseLayout>
