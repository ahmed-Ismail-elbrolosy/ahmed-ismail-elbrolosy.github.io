---
import { assetPath } from '../utils/paths';
import MediaPlaceholder from './MediaPlaceholder.astro';
import VideoPlayer from './VideoPlayer.astro';
import DocumentEmbed from './DocumentEmbed.astro';

type Media = string | {
  type: 'image';
  src: string;
  alt?: string;
  label: string;
  caption: string;
} | {
  type: 'video';
  src: string;
  label: string;
  caption: string;
  poster?: string;
  ratio?: 'wide' | 'landscape' | 'portrait' | 'cinematic';
  silent?: boolean;
  captions?: { src: string; label: string; language: string };
} | {
  type: 'document';
  src: string;
  label: string;
  caption: string;
};

interface Props {
  media: Media;
  ratio?: 'wide' | 'standard' | 'square';
  index?: string;
  showCaption?: boolean;
  projectUrl?: string;
}

const { media, ratio = 'wide', index, showCaption = true, projectUrl } = Astro.props;
---

{typeof media === 'string' ? (
  <MediaPlaceholder label={media} ratio={ratio} index={index} />
) : media.type === 'video' ? (
  <VideoPlayer {...media} index={index} showCaption={showCaption} />
) : media.type === 'document' ? (
  <DocumentEmbed {...media} index={index} showCaption={showCaption} />
) : (
  <figure class:list={['project-image', `media-${ratio}`]}>
    <div
      class="project-image-frame"
      data-lightbox-trigger
      data-lightbox-src={assetPath(media.src)}
      data-lightbox-alt={media.alt ?? media.label}
      data-lightbox-label={media.label}
      data-lightbox-caption={media.caption}
      data-lightbox-project-url={projectUrl}
      role="button"
      tabindex="0"
      aria-label={`Enlarge image: ${media.label}`}
    >
      {index && <span class="media-index">{index}</span>}
      <img src={assetPath(media.src)} alt={media.alt ?? ''} loading="lazy" />
      <span class="media-zoom-badge" aria-hidden="true">
        <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor">
          <path d="M1.5 1a.5.5 0 0 0-.5.5v4a.5.5 0 0 0 1 0V2h3.5a.5.5 0 0 0 0-1h-4ZM10 1a.5.5 0 0 0 0 1h3.5v3.5a.5.5 0 0 0 1 0v-4a.5.5 0 0 0-.5-.5h-4ZM1 10.5a.5.5 0 0 0-.5.5v4a.5.5 0 0 0 .5.5h4a.5.5 0 0 0 0-1H2v-3.5a.5.5 0 0 0-.5-.5Zm14 0a.5.5 0 0 0-.5.5V14h-3.5a.5.5 0 0 0 0 1h4a.5.5 0 0 0 .5-.5v-4a.5.5 0 0 0-.5-.5Z"/>
        </svg>
        <span>EXPAND</span>
      </span>
    </div>
    {showCaption && <figcaption><strong>{media.label}</strong><span>{media.caption}</span></figcaption>}
  </figure>
)}
