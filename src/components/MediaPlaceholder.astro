---
interface Props {
  label: string;
  ratio?: 'wide' | 'standard' | 'square';
  caption?: string;
  index?: string;
}

const { label, ratio = 'wide', caption = 'Media pending — replace with project evidence.', index } = Astro.props;
---

<figure class:list={['media-placeholder', `media-${ratio}`]}>
  <div class="media-grid" aria-label={`${label} placeholder`} role="img">
    <span class="media-index">{index ?? 'MEDIA'}</span>
    <span class="media-crosshair" aria-hidden="true"></span>
    <strong>{label}</strong>
    <span class="media-format">IMAGE / VIDEO / DIAGRAM</span>
  </div>
  <figcaption>{caption}</figcaption>
</figure>
