---
import MediaPlaceholder from './MediaPlaceholder.astro';

interface Props {
  number: number;
  title: string;
  description: string;
  media: string[];
}

const { number, title, description, media } = Astro.props;
const sectionNumber = number.toString().padStart(2, '0');
---

<section class="project-section" aria-labelledby={`section-${sectionNumber}`}>
  <div class="section-heading">
    <span>{sectionNumber} /</span>
    <h2 id={`section-${sectionNumber}`}>{title}</h2>
  </div>
  <div class="section-content">
    <p>{description}</p>
    {media.length > 0 && (
      <div class:list={['section-media', { 'media-pair': media.length > 1 }]}>
        {media.map((label, index) => (
          <MediaPlaceholder label={label} ratio={media.length > 1 ? 'standard' : 'wide'} index={`${sectionNumber}.${index + 1}`} />
        ))}
      </div>
    )}
  </div>
</section>
